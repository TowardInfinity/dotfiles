# macOS
.DS_Store

# Backups created by install.sh
*.backup.*

# tmux runtime state — plugins are fetched by TPM, resurrect snapshots are
# machine-local. Only the .conf files belong in here.
*/tmux/plugins/
*/tmux/resurrect/

# nvim runtime state. lazy-lock.json IS tracked on purpose (it pins every
# plugin to a known-good commit); everything below is generated.
common/nvim/.git/
common/nvim/lazy/
common/nvim/mason/
common/nvim/base46/
common/nvim/spell/

# Ghostty writes nothing here, but it does keep old configs around
macos/ghostty/*.pre-*

# Machine-local shell overrides — intentionally untracked
.zshrc.local
bin/dots-bin
# Anchored to the repo root. A bare `dots` also matches the cmd/dots/
# DIRECTORY, which silently ignored every new source file added there —
# actions_cli.go never got committed and CI failed on an undefined symbol.
/dots

# Debugging output captured while testing. err2.log reached a public repo this
# way — 899 bytes of a Neovim stack trace, carrying the absolute path of the
# scratchpad it was produced in. Nothing here should ever be tracked.
*.log

# Python bytecode from syntax-checking bin/*.py. install.sh runs those scripts
# directly, which caches nothing — this only appears after a py_compile or
# compileall. It matters because `dots sync` stages untracked files, so an
# ignored-by-nobody .pyc gets offered up for commit on the next sync.
__pycache__/
*.py[cod]
