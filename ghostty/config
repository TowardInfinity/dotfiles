# Ghostty config — upgraded 2026-07-19 (previous version: config.pre-2026-07-19)

# ── Fonts ────────────────────────────────────────────────────
# Nerd Font → icons in eza, lazygit, starship etc.
font-family = "JetBrainsMono Nerd Font"
font-size = 14
font-thicken = true

# ── Colors (Tokyo Night, kept from previous config) ──────────
background = #1a1b26
foreground = #c0caf5
cursor-color = #c0caf5
selection-background = #364a82

# ── Cursor ───────────────────────────────────────────────────
cursor-style = bar
cursor-style-blink = true

# ── Window ───────────────────────────────────────────────────
window-padding-x = 16
window-padding-y = 12
background-opacity = 0.92
background-blur-radius = 20
macos-titlebar-style = tabs
window-save-state = always
unfocused-split-opacity = 0.82

# ── Behavior ─────────────────────────────────────────────────
shell-integration = zsh
# ssh-terminfo → installs xterm-ghostty terminfo on remote hosts on first connect,
#   so tmux/vim inside the VM render correctly instead of falling back to dumb.
# ssh-env      → propagates TERM/COLORTERM for hosts where terminfo install fails.
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo
mouse-hide-while-typing = true
copy-on-select = true
confirm-close-surface = false
scrollback-limit = 100000000
clipboard-paste-protection = true

# ── Splits ───────────────────────────────────────────────────
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+shift+u=new_split:right
keybind = cmd+[=goto_split:previous
keybind = cmd+]=goto_split:next
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+enter=toggle_split_zoom
keybind = cmd+ctrl+left=resize_split:left,40
keybind = cmd+ctrl+right=resize_split:right,40
keybind = cmd+ctrl+up=resize_split:up,40
keybind = cmd+ctrl+down=resize_split:down,40
keybind = cmd+shift+e=equalize_splits

# ── Global hotkeys (need Accessibility permission)
# Ctrl+`       → dropdown quick terminal (toggle)
# Ctrl+Shift+` → new full terminal window from anywhere
keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = global:ctrl+shift+grave_accent=new_window

# ── Misc ─────────────────────────────────────────────────────
keybind = cmd+r=reload_config
keybind = cmd+shift+comma=open_config
